[sub_resource type="Shader" id="Shader_52sao"]
code = "shader_type canvas_item;
vec2 random(vec2 uv) {
	return vec2(fract(sin(dot(uv.xy,
		vec2(12.9898,78.233))) * 43758.5453123));
}

varying mat4 world_to_screen;
varying mat4 screen_to_world;

void vertex(){
	world_to_screen = SCREEN_MATRIX * CANVAS_MATRIX;
	screen_to_world = inverse(world_to_screen);
}

vec2 voronoi(vec2 uv, float columns, float rows) {

	vec2 index_uv = floor(vec2(uv.x * columns, uv.y * rows));
	vec2 fract_uv = fract(vec2(uv.x * columns, uv.y * rows));

	float minimum_dist = 1.0;
	vec2 minimum_point;

	for (int y= -1; y <= 1; y++) {
		for (int x= -1; x <= 1; x++) {
			vec2 neighbor = vec2(float(x),float(y));
			vec2 point = random(index_uv + neighbor);

			vec2 diff = neighbor + point - fract_uv;
			float dist = length(diff);

			if(dist < minimum_dist) {
				minimum_dist = dist;
				minimum_point = point;
			}
		}
	}
	return minimum_point;
}
uniform float scale  = 1.0;
uniform vec4 color: source_color;
const vec2 fixed_scale = vec2(1.0, 1.6);
void fragment() {



	vec2 uv = SCREEN_UV;
	// Puts uv in world space

	uv = uv * 2.0 - 1.0;
	uv = (screen_to_world * vec4(uv,0,1)).xy;

	// Apply an offset of 20 units
	vec2 cell = voronoi(uv * scale * fixed_scale, 10.0, 5.0);
	float brightness = 0.5 + 0.5 * cell.r; // 將 0~1 映射到 0.5~1.0
	COLOR = vec4(color.rgb * brightness, 1.0);

	// Puts uv back in screen space
	uv = (world_to_screen * vec4(uv,0,1)).xy;
	uv = uv * 0.5 + 0.5;



}"

